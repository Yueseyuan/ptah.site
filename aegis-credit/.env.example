# Aegis Credit Intelligence — Environment Configuration
# Copy to .env and fill in values

# Database (PostgreSQL for production, SQLite for dev)
DATABASE_URL=postgresql://aegis:your_password@localhost:5432/aegis

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Anthropic Claude API key (required for AI features: report parsing, strategy, findings)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=change-me-in-production

# Optional: set to "True" to bypass JWT auth (dev only, never in production)
# DEV_NO_AUTH=True
