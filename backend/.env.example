# APEX AI — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# App
APP_NAME=APEX AI
APP_VERSION=0.1.0
DEBUG=false

# Database
# SQLite (default, dev)
DATABASE_URL=sqlite+aiosqlite:///./apex_data/database/apex.db
# PostgreSQL (server deployment)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/apex

# Security — CHANGE THIS in production
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── AI Model Backends ─────────────────────────────────────────────────────────
# All optional — configure only what you use

# FREE OPTION: free-claude-code proxy
# 1. Install: irm https://github.com/Alishahryar1/free-claude-code/blob/main/scripts/install.ps1?raw=1 | iex
# 2. Run: fcc-server --port 8003
# 3. Uncomment: ANTHROPIC_BASE_URL=http://localhost:8003

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080
LMSTUDIO_BASE_URL=http://localhost:1234
LOCALAI_BASE_URL=http://localhost:8080
VLLM_BASE_URL=http://localhost:8000

# ── Media Generation ──────────────────────────────────────────────────────────
# Sign up free at huggingface.co → Settings → Access Tokens
HUGGINGFACE_API_TOKEN=hf_...

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# Sign up at sendgrid.com → Settings → API Keys → Create key (Full Access)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=you@yourdomain.com

# ── Social Media: Twitter / X ─────────────────────────────────────────────────
# developer.twitter.com → Projects & Apps → New App → Keys and Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── Social Media: LinkedIn ────────────────────────────────────────────────────
# developer.linkedin.com → My Apps → Auth → OAuth 2.0 tokens
# Person ID: from GET https://api.linkedin.com/v2/me → id field
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# ── Social Media: Facebook / Instagram ───────────────────────────────────────
# developers.facebook.com → My Apps → Graph API → Generate token
# Page ID: your Facebook Page numeric ID
# Instagram Business Account ID: from Graph API /me/accounts
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
