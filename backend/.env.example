# APEX AI — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# App
APP_NAME=APEX AI
APP_VERSION=0.1.0
DEBUG=false

# Database
# SQLite (default, dev)
DATABASE_URL=sqlite+aiosqlite:///./apex_data/database/apex.db
# PostgreSQL (server deployment)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/apex

# Security — CHANGE THIS in production
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Backends (all optional — configure only what you use)

# ── FREE OPTION: free-claude-code proxy (recommended) ──────────────────────
# 1. Install: irm https://github.com/Alishahryar1/free-claude-code/blob/main/scripts/install.ps1?raw=1 | iex
# 2. Run: fcc-server --port 8003   (starts proxy on localhost:8003)
# 3. Configure free providers (Gemini, NVIDIA NIM, OpenRouter) in Admin UI at http://localhost:8003/admin
# 4. Uncomment the line below — no real API key needed:
# ANTHROPIC_BASE_URL=http://localhost:8003

# ── PAID/LOCAL OPTIONS ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080
LMSTUDIO_BASE_URL=http://localhost:1234
LOCALAI_BASE_URL=http://localhost:8080
VLLM_BASE_URL=http://localhost:8000
