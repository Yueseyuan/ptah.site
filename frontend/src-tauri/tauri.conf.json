{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APEX AI",
  "version": "0.1.0",
  "identifier": "ai.apex.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "APEX AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI operating system for PTAH Consultants",
    "longDescription": "APEX AI is a local-first AI operating system featuring agent registry, memory subsystem, knowledge graph, workflow engine, and repository review pipeline.",
    "publisher": "PTAH Consultants",
    "copyright": "Copyright © 2024 PTAH Consultants"
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://releases.apex.ai/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
